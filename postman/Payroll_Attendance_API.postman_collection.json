{
  "info": {
    "_postman_id": "8f3b6a22-1d54-4a29-87a4-84c1f9b3e100",
    "name": "Payroll Attendance API",
    "description": "Complete Postman API Collection for WorkPulse - Payroll Staff Attendance Capture System connected to Spring Boot & PostgreSQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var token = pm.environment.get('authToken');",
          "var urlPath = pm.request.url.getPath ? pm.request.url.getPath() : '';",
          "var isAuthEndpoint = (urlPath.indexOf('login') !== -1 || urlPath.indexOf('health') !== -1 || urlPath.indexOf('google') !== -1);",
          "if (!token && !isAuthEndpoint) {",
          "    var baseUrl = pm.environment.get('baseUrl') || 'http://localhost:8080/api';",
          "    var adminEmail = pm.environment.get('adminEmail') || 'admin@workpulse.com';",
          "    var adminPassword = pm.environment.get('adminPassword') || 'Admin@123';",
          "    pm.sendRequest({",
          "        url: baseUrl + '/auth/login',",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: {",
          "            mode: 'raw',",
          "            raw: JSON.stringify({ emailOrId: adminEmail, password: adminPassword })",
          "        }",
          "    }, function (err, res) {",
          "        if (!err && res.code === 200) {",
          "            var resJson = res.json();",
          "            if (resJson && resJson.data && resJson.data.token) {",
          "                pm.environment.set('authToken', resJson.data.token);",
          "                pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + resJson.data.token });",
          "            }",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Health",
      "item": [
        {
          "name": "Health Check & Database State",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Database is connected to PostgreSQL', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.database).to.eql('CONNECTED');",
                  "    pm.expect(json.data.databaseProduct).to.eql('PostgreSQL');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
